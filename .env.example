# =============================================================================
# SBS Deutschland – Invoice App: Beispiel-Umgebungskonfiguration
# Kopieren nach `.env` und Werte setzen. NIEMALS echte Secrets committen!
# =============================================================================

# --- Laufzeit / Umgebung -----------------------------------------------------
# development | staging | production
ENVIRONMENT=production
APP_ENV=production
FLOWCHECK_RUNTIME_ENV=production
APP_BASE_URL=https://app.sbsdeutschland.com
APP_URL=https://app.sbsdeutschland.com
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
# Pfad für Legacy-Anwendungs-Logs (muss beschreibbar sein)
APP_LOG_PATH=/var/www/invoice-app/logs/app.log

# --- Sicherheit / Sessions (PFLICHT in Produktion) ---------------------------
# Lange, zufällige Werte! z.B. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
APP_SECRET_KEY=change-me-please-very-long-random
SECRET_KEY=change-me-please-very-long-random
SESSION_SECRET_KEY=change-me-please-very-long-random
JWT_SECRET_KEY=change-me-please-very-long-random

# --- Datenbank ---------------------------------------------------------------
# Kanonische modulare Runtime. Standard-URLs `postgresql://...` werden intern
# auf den Psycopg-3-Treiber normalisiert.
DATABASE_URL=postgresql://user:password@db.example.invalid:5432/sbs_nexus
# Legacy SQLite-Pfad; nur für noch nicht migrierte Legacy-Komponenten.
INVOICE_DB_PATH=/var/www/invoice-app/invoices.db
# Datei-Upload-Verzeichnis
UPLOAD_DIR=/var/www/invoice-app/web/uploads

# --- KI / LLM (für Rechnungs-Extraktion) -------------------------------------
FLOWCHECK_DEFAULT_INFERENCE_PROFILE=standard
FLOWCHECK_POLICY_ENFORCEMENT=block
FLOWCHECK_REQUIRE_EU_REGIONAL_CLOUD_IN_PRODUCTION=true
FLOWCHECK_PROVIDER_GOVERNANCE_ENFORCEMENT=block
FLOWCHECK_CLOUD_PROCESSING_REGION=UNSET
FLOWCHECK_PROVIDER_DEPLOYMENT_CONFIG=
FLOWCHECK_PROVIDER_ENDPOINT_HOST_ALLOWLIST=
FLOWCHECK_AZURE_ADAPTERS_ENABLED=false
FLOWCHECK_AZURE_AUTH_MODE=entra
FLOWCHECK_AZURE_IDENTITY_MODE=managed_identity
FLOWCHECK_AZURE_MANAGED_IDENTITY_CLIENT_ID=
FLOWCHECK_AZURE_ALLOW_DEVELOPER_CREDENTIALS=false
FLOWCHECK_AZURE_ALLOWED_REGION=
FLOWCHECK_AZURE_ENDPOINT_HOST_ALLOWLIST=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_SCOPE=https://cognitiveservices.azure.com/.default
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-invoice
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=
LOCAL_OCR_ENABLED=false
# MBR (Monthly Business Review)
MBR_USE_LLM=0
MBR_LLM_API_KEY=
MBR_LLM_MODEL=gpt-4o

# --- E-Mail (Versand & Posteingang) ------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@sbsdeutschland.com
RESEND_FROM_ADDRESS=info@sbsdeutschland.com
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=info@sbsdeutschland.com
# Alternativ SMTP:
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Posteingang (optionaler IMAP-Import)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_PROCESSED_FOLDER=Processed

# --- SSO / OAuth (optional) --------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Zahlungen / Stripe (optional) -------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# --- API-Gateway / Integrationen (optional) ----------------------------------
INVOICE_API_KEY=
NEXUS_API_KEY=
# SBS_API_KEY ist nur gültig, wenn die Identität explizit tenant-gebunden ist.
SBS_API_KEY=
SBS_API_KEY_TENANT_ID=
SBS_API_KEY_USER_ID=
SBS_API_KEY_ROLE=service
SLACK_WEBHOOK_URL=
CORS_ALLOWED_ORIGINS=https://app.sbsdeutschland.com

# --- Monitoring (optional) ---------------------------------------------------
SENTRY_DSN=
SENTRY_ENV=production
