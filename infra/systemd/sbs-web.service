[Unit]
Description=SBS Deutschland marketing web layer (Next.js)
Documentation=https://github.com/SBS-Nexus/sbs-web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/sbs-web
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=HOSTNAME=127.0.0.1
# Built with `next build` (output: standalone); the server bundle is self-contained.
ExecStart=/usr/bin/node /var/www/sbs-web/server.js
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

# The marketing layer needs no write access anywhere and no secrets.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=512M

[Install]
WantedBy=multi-user.target
