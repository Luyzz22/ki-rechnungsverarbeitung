    "check:content": "node scripts/check-content.mjs",
    "artifact": "./scripts/build-artifact.sh",
    "check:ui": "node scripts/check-ui.mjs"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SBS-Nexus/sbs-web.git"
  }
