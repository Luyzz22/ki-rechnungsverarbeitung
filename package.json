{
  "name": "sbs-web",
  "version": "1.0.0",
  "private": true,
  "description": "SBS Deutschland enterprise web ecosystem: corporate, industry and legal division sites on one design system.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
